{
  "name": "ew-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "env:local": "cp env/local-supabase.env .env.local",
    "env:remote": "cp env/remote-supabase.env .env.local",
    "dev": "next dev",
    "dev:local": "npm run env:local && next dev",
    "dev:remote": "npm run env:remote && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:start": "cd db/supabase && supabase start",
    "db:reset": "npm run db:seed:export-basic-info && npm run db:seed:verify-basic-info && cd db/supabase && supabase db reset",
    "db:reset:fresh": "cd db/supabase && supabase db reset",
    "db:seed:export-basic-info": "python3 scripts/export_basic_info_seeds.py",
    "db:seed:verify-basic-info": "python3 scripts/verify_basic_info_seeds.py",
    "test": "./node_modules/.bin/vitest run",
    "test:watch": "./node_modules/.bin/vitest",
    "test:crm": "./node_modules/.bin/vitest run __tests__/customer-form.test.tsx",
    "test:guard:use-server": "node ./scripts/check_use_server_exports.mjs",
    "test:smoke:routes": "node ./scripts/run_route_smoke.mjs",
    "test:regression:ui": "npm run test:guard:use-server && ./node_modules/.bin/vitest run __tests__/dashboards-regression.test.tsx __tests__/basic-info-dashboards-regression.test.tsx __tests__/basic-info-page-contracts.test.tsx __tests__/basic-info-actions-contracts.test.ts __tests__/partner-page-contracts.test.tsx __tests__/partner-actions-contracts.test.ts",
    "test:regression:reset-safe": "node ./scripts/run_reset_safe_regression.mjs",
    "test:regression": "npm run test:regression:ui && npm run test:smoke:routes && npm run test:e2e:purchase && node ./scripts/run_local_regression.mjs && npm run test:regression:reset-safe",
    "test:e2e": "playwright test",
    "test:e2e:purchase": "playwright test e2e/purchase-regression.spec.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.99.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "jsdom": "^25.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
